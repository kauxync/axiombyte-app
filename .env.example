# AxiomByte Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NOTE: The '.env' file is ignored by git and will NEVER be leaked or published to GitHub.

# 1. Google Cloud Console OAuth 2.0 Web Client ID
# (Get from: https://console.cloud.google.com/apis/credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. GitHub Developer OAuth Application Client ID
# (Get from: https://github.com/settings/developers)
EXPO_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id

# 3. Hostinger Backend API Domain (Storage & MySQL)
EXPO_PUBLIC_API_BASE_URL=https://axiombytedb.kauxync.in

# 4. Web OAuth Broker Domain (Web Login & Deep Linking)
EXPO_PUBLIC_OAUTH_BROKER_URL=https://axiombyte.kauxync.in

